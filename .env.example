# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="Leave System <noreply@yourdomain.com>"

# Public site URL, used for building links in emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authorizes Vercel's yearly cron call to /api/cron/sync-holidays (see
# vercel.json). Generate any random string; Vercel sends it back as
# `Authorization: Bearer <value>` automatically once this is set as a
# Project > Settings > Environment Variable — no extra wiring needed.
CRON_SECRET=
